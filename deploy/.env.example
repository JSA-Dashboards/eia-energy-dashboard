# Copy to /opt/eia-energy-dashboard/.env on the Droplet. Same SNOWFLAKE_*
# convention as every other Droplet job (see reference_jsa_droplet memory) --
# key-pair auth is preferred, SNOWFLAKE_PASSWORD is only the fallback.

EIA_API_KEY=your-eia-api-key

USE_SNOWFLAKE=1
SNOWFLAKE_ACCOUNT=GNC89034.us-east-1
SNOWFLAKE_USER=KOLTENPOSTIN
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=JSA
SNOWFLAKE_SCHEMA=EIA_ETHANOL_CACHE
SNOWFLAKE_PRIVATE_KEY_PATH=/root/.snowflake/rsa_key.p8
